# Run python3 scripts/setup.py to generate a private .env. Never copy example keys.
MAILHUB_PUBLIC_URL=https://mail.example.com
MAILHUB_DOMAIN=mail.example.com
MAILHUB_ADMIN_HASH=
MAILHUB_KEY=
MAILHUB_DATA_DIR=./data
MAILHUB_SYNC_SECONDS=300
MAILHUB_SYNC_DAYS=30
MAILHUB_SYNC_LIMIT=200
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
