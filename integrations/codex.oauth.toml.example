# OAuth connection: merge into the active Codex config, then run:
# Read only: codex mcp login mailharbor --scopes mail.read
# To also reply: codex mcp login mailharbor --scopes mail.read,mail.reply
[mcp_servers.mailharbor]
url = "https://mail.example.com/mcp"
startup_timeout_sec = 20
tool_timeout_sec = 45
enabled_tools = ["list_accounts", "search_emails", "read_email", "get_sync_status", "reply_email"]
